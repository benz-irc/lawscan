{
  // ล่ามของโปรเจกต์ ไม่ใช่ python ของเครื่อง — lawscan ลงไว้ในนี้ด้วย pip install -e .
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // เทสต์ขึ้นในแถบ Testing ทางซ้าย กดรันทีละข้อได้
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // คีย์ Gemini ในเครื่องเครดิตหมด ถ้าไม่ตั้งตัวนี้ทุกคำสั่งที่เรียกโมเดลจะล้ม
  // ด้วย 429 RESOURCE_EXHAUSTED ตั้งไว้ที่นี่แล้ว terminal ใน VS Code ได้ทุกหน้าต่าง
  "terminal.integrated.env.osx": {
    "LAWSCAN_MODEL": "gpt-5-nano"
  },

  "files.exclude": {
    "**/__pycache__": true,
    "**/*.egg-info": true,
    "**/.pytest_cache": true
  },

  // ไฟล์ข้อความไทยและ CSV ของผู้ดูแล เปิดแล้วอย่าให้ตัวแก้ไขไปยุ่งกับท้ายบรรทัด
  "files.trimTrailingWhitespace": false,
  "[markdown]": { "files.trimTrailingWhitespace": false }
}
