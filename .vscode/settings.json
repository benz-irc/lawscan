{
  // ล่ามของโปรเจกต์ ไม่ใช่ python ของเครื่อง — lawscan ลงไว้ในนี้ด้วย pip install -e .
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // เทสต์ขึ้นในแถบ Testing ทางซ้าย กดรันทีละข้อได้
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // ไม่ตั้ง LAWSCAN_MODEL ไว้ที่นี่ — เคยตั้งเป็น gpt-5-nano ตอนเครดิต Gemini หมด
  // แล้วสถานการณ์กลับด้าน คือเครดิต OpenAI หมดแทน ผลคือทุก terminal ใน VS Code
  // ยิงไปที่บัญชีที่ตอบ 429 อย่างเงียบ ๆ ทับค่าปริยายในโค้ดที่ถูกต้องอยู่แล้ว
  // จะเปลี่ยนโมเดลให้ใส่หน้าคำสั่งทีละครั้ง: LAWSCAN_MODEL=... lawscan scan ...

  "files.exclude": {
    "**/__pycache__": true,
    "**/*.egg-info": true,
    "**/.pytest_cache": true
  },

  // ไฟล์ข้อความไทยและ CSV ของผู้ดูแล เปิดแล้วอย่าให้ตัวแก้ไขไปยุ่งกับท้ายบรรทัด
  "files.trimTrailingWhitespace": false,
  "[markdown]": { "files.trimTrailingWhitespace": false }
}
