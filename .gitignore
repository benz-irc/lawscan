# The API key. Never commit, never print, never paste into an issue.
.env
.env.*
!.env.example

# Environment
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Extracted text. Derived from the PDFs, deterministic, six megabytes, and
# rebuilt by `lawscan ocr` in four seconds — a copy in history would age out of
# step with the code that produced it.
text/

# Kept runs. Evidence of one afternoon's measurement, not source: a folder per
# run, several megabytes each, and regenerated by `lawscan etl`. The test files
# in the same directory are source and are not matched by these.
tests/result40-*/
tests/compare40-*/
out/

# The source documents. The operator's own corpus — 19 MB of Gazette PDFs that
# belong to whoever runs this, not to the program.
pdfs/*.pdf

# The reference spreadsheet. Someone's own reading of forty laws, answer by
# answer — their work, not this program's, and not ours to publish. Every
# command that wants it takes a path, so a copy anywhere on disk works:
#
#   lawscan diff out/r.csv --expected /path/to/expected.csv
#
# Without it `lawscan diff` has nothing to compare against and the test that
# guards the prompts against containing its answers skips itself. Both say so
# rather than passing quietly.
data/expected.csv

# Rendered pages, kept while looking at what an image page contains.
*.png

# macOS
.DS_Store
