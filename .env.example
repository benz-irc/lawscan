# Copy to .env and fill in. .env is gitignored and should stay that way.
#
#   cp .env.example .env && chmod 600 .env
#
# The key is read from the environment first and from .env second, so a server
# can set it without a file and a person can keep a file without exporting it.
# It is never logged and never written anywhere by this program.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash.
# LAWSCAN_MODEL=
